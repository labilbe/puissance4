@using Puissance4.Core
@using Puissance4.Web.Game
@implements IAsyncDisposable
@inject IJSRuntime Js

<PageTitle>Puissance 4</PageTitle>

<div class="room">
    <header class="masthead">
        <h1 class="masthead__title">Puissance 4</h1>
        <p class="masthead__note">Sept colonnes, six rangées, quatre jetons à aligner.</p>
    </header>

    <main class="table">
        <section class="stage">
            <div class="board @(_session.ShowNumbers ? null : "board--bare")">
                <div class="board__numbers" aria-hidden="true">
                    @for (int col = 0; col < Grid.Columns; col++)
                    {
                        <span class="board__number">@Grid.NumberOf(col)</span>
                    }
                </div>

                @* Trois calques : le panneau percé, les jetons qui glissent derrière lui,
                   et par-dessus les sept colonnes cliquables avec leurs biseaux. *@
                <div class="board__panel">
                    @for (int cell = 0; cell < Grid.CellCount; cell++)
                    {
                        <span class="back" aria-hidden="true"></span>
                    }

                    <div class="board__discs" aria-hidden="true">
                        @foreach (DiscView disc in _session.Discs)
                        {
                            <div @key="disc.Id"
                                 class="disc @(disc.Owner == Player.Red ? "disc--red" : "disc--yellow") @(disc.Winning ? "disc--winning" : null)"
                                 style="--r:@disc.Row; --c:@disc.Col"></div>
                        }
                    </div>

                    <div class="board__columns">
                        @for (int col = 0; col < Grid.Columns; col++)
                        {
                            int column = col;

                            <button type="button"
                                    class="column @(_session.LastCell is int last && Grid.Col(last) == column ? "is-last" : null)"
                                    style="--landing:@_session.LandingRow(column)"
                                    disabled="@(!_session.CanPlay(column))"
                                    aria-label="@ColumnLabel(column)"
                                    @onclick="@(() => _session.ClickAsync(column))">
                                @for (int row = 0; row < Grid.Rows; row++)
                                {
                                    <span class="hole"></span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="tally">
                <span class="tally__side">
                    <span class="chip chip--red"></span>
                    Rouges, @_session.RedCount jetons
                </span>
                <span class="tally__side">
                    <span class="chip chip--yellow"></span>
                    Jaunes, @_session.YellowCount jetons
                </span>
            </div>
        </section>

        <aside class="rail">
            <div class="turn @(_session.Result.IsOver() ? "turn--over" : null)" aria-live="polite">
                <span class="turn__mark @(_session.SideToMove == Player.Red ? "turn__mark--red" : "turn__mark--yellow")"></span>
                <span class="turn__text">@StatusLine()</span>
                @if (Hint() is string hint)
                {
                    <span class="turn__hint">@hint</span>
                }
            </div>

            <div class="panel">
                <div class="seat">
                    <span class="seat__name">Rouges</span>
                    @foreach (Seat seat in Seats)
                    {
                        <button type="button"
                                class="pill @(_session.RedSeat == seat ? "pill--on" : null)"
                                @onclick="@(() => _session.SetSeatAsync(Player.Red, seat))">
                            @SeatName(seat)
                        </button>
                    }
                </div>
                <div class="seat">
                    <span class="seat__name">Jaunes</span>
                    @foreach (Seat seat in Seats)
                    {
                        <button type="button"
                                class="pill @(_session.YellowSeat == seat ? "pill--on" : null)"
                                @onclick="@(() => _session.SetSeatAsync(Player.Yellow, seat))">
                            @SeatName(seat)
                        </button>
                    }
                </div>

                @if (_session.RedSeat == Seat.Computer || _session.YellowSeat == Seat.Computer)
                {
                    <label class="field">
                        <span class="field__name">Niveau de l'ordinateur</span>
                        <select value="@_session.Difficulty"
                                @onchange="OnDifficultyChanged">
                            @foreach (Difficulty level in Levels)
                            {
                                <option value="@level">@SearchOptions.ToFrench(level)</option>
                            }
                        </select>
                    </label>
                }

                <label class="check">
                    <input type="checkbox" checked="@_session.ShowNumbers" @onchange="OnNumbersToggled" />
                    <span>Numéroter les colonnes</span>
                </label>

                <div class="actions">
                    <button type="button" class="button" disabled="@(!_session.CanUndo)" @onclick="_session.Undo">
                        Annuler le coup
                    </button>
                    <button type="button" class="button button--strong" disabled="@_session.Busy" @onclick="_session.NewGameAsync">
                        Nouvelle partie
                    </button>
                </div>
            </div>

            <div class="record">
                <h2 class="record__name">Relevé</h2>
                @if (_session.History.Count == 0)
                {
                    <p class="record__empty">Aux Rouges de commencer. Cliquez une colonne pour y lâcher un jeton.</p>
                }
                else
                {
                    int offset = _session.OpensWithYellow ? 1 : 0;

                    <ol class="record__list">
                        @for (int i = 0; i < _session.History.Count + offset; i += 2)
                        {
                            <li class="record__turn">
                                <span class="record__number">@(i / 2 + 1)</span>
                                <span class="record__move">@MoveAt(i - offset)</span>
                                <span class="record__move">@MoveAt(i + 1 - offset)</span>
                            </li>
                        }
                    </ol>
                }
            </div>

            <div class="panel">
                <h2 class="record__name">Partie au format PCN</h2>

                @if (_pcnBox is null)
                {
                    <div class="actions actions--three">
                        <button type="button" class="button" @onclick="CopyPcn">Copier</button>
                        <button type="button" class="button" @onclick="DownloadPcn">Enregistrer</button>
                        <button type="button" class="button" @onclick="OpenImport">Ouvrir…</button>
                    </div>
                }
                else
                {
                    <textarea class="pcn" rows="7" spellcheck="false"
                              placeholder="Collez ici le PCN d'une partie, ou sa suite de colonnes : 4453."
                              @bind="_pcnBox" @bind:event="oninput"></textarea>

                    <div class="actions">
                        <button type="button" class="button" @onclick="CloseImport">Annuler</button>
                        <button type="button" class="button button--strong" @onclick="ImportPcn">Ouvrir la partie</button>
                    </div>
                }

                @if (_pcnMessage is string message)
                {
                    <p class="notice @(_pcnFailed ? "notice--bad" : null)">@message</p>
                }
            </div>
        </aside>
    </main>
</div>

@code {
    private static readonly Seat[] Seats = [Seat.Human, Seat.Computer];

    private static readonly Difficulty[] Levels =
        [Difficulty.Easy, Difficulty.Medium, Difficulty.Hard, Difficulty.Expert];

    private readonly GameSession _session = new();

    private IJSObjectReference? _helpers;
    private string? _pcnBox;
    private string? _pcnMessage;
    private bool _pcnFailed;

    protected override void OnInitialized() => _session.Changed += Redraw;

    public async ValueTask DisposeAsync()
    {
        _session.Changed -= Redraw;

        if (_helpers is not null)
        {
            try
            {
                await _helpers.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // La page se ferme : le module est déjà parti avec elle.
            }
        }
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private string MoveAt(int index) =>
        index >= 0 && index < _session.History.Count ? _session.History[index].Notation : string.Empty;

    private async Task<IJSObjectReference> HelpersAsync() =>
        _helpers ??= await Js.InvokeAsync<IJSObjectReference>("import", "./app.js");

    private async Task CopyPcn()
    {
        IJSObjectReference helpers = await HelpersAsync();
        bool copied = await helpers.InvokeAsync<bool>("copyText", _session.ToPcn());
        Report(copied ? "PCN copié." : "Le navigateur a refusé l'accès au presse-papiers.", failed: !copied);
    }

    private async Task DownloadPcn()
    {
        IJSObjectReference helpers = await HelpersAsync();
        await helpers.InvokeVoidAsync("downloadText", "partie.pcn", _session.ToPcn());
        Report("Partie enregistrée dans partie.pcn.", failed: false);
    }

    private void OpenImport()
    {
        _pcnBox = string.Empty;
        _pcnMessage = null;
    }

    private void CloseImport()
    {
        _pcnBox = null;
        _pcnMessage = null;
    }

    private async Task ImportPcn()
    {
        string? error = await _session.ImportPcnAsync(_pcnBox ?? string.Empty);

        if (error is null)
        {
            _pcnBox = null;
            Report($"Partie ouverte, {_session.History.Count} coups rejoués.", failed: false);
        }
        else
        {
            Report(error, failed: true);
        }
    }

    private void Report(string message, bool failed)
    {
        _pcnMessage = message;
        _pcnFailed = failed;
    }

    private Task OnDifficultyChanged(ChangeEventArgs args) =>
        Enum.TryParse(args.Value?.ToString(), out Difficulty level)
            ? _session.SetDifficultyAsync(level)
            : Task.CompletedTask;

    private void OnNumbersToggled(ChangeEventArgs args) =>
        _session.ShowNumbers = args.Value is true;

    private static string SeatName(Seat seat) => seat == Seat.Human ? "Vous" : "Ordinateur";

    private string ColumnLabel(int column)
    {
        int landing = _session.LandingRow(column);
        string state = landing < 0 ? "pleine" : $"{Grid.Rows - 1 - landing} jetons posés";

        return $"Colonne {Grid.NumberOf(column)}, {state}";
    }

    private string StatusLine()
    {
        if (_session.Result.IsOver())
        {
            return _session.Result switch
            {
                GameResult.RedWins => "Les Rouges gagnent",
                GameResult.YellowWins => "Les Jaunes gagnent",
                _ => "Grille pleine, partie nulle",
            };
        }

        if (_session.IsThinking)
        {
            return "L'ordinateur réfléchit";
        }

        string side = _session.SideToMove.ToFrench();
        return _session.SeatOf(_session.SideToMove) == Seat.Human
            ? $"Aux {side}, à vous de jouer"
            : $"Aux {side}";
    }

    private string? Hint()
    {
        if (_session.Result.IsOver() || _session.IsThinking || _session.Busy)
        {
            return null;
        }

        return _session.IsUnderThreat ? "Attention, l'adversaire aligne au prochain coup" : null;
    }
}
